# Copy this file to .env and customize values for your local machine.
# Do not commit actual .env files or production secrets.

CI_ENVIRONMENT = development

# Run local server with: php spark serve --port 8000
app.baseURL = 'http://localhost:8000/'
app.forceGlobalSecureRequests = false

# XAMPP MySQL connection: change port to 3306 if that is your actual MySQL port.
database.default.hostname = 127.0.0.1
database.default.database = smpit_alfirdaus
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3307

# Configure only if the application uses CI4 encryption services; use a unique key.
encryption.key =
